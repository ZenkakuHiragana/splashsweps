"Screenspace_General_8Tex"
{
    // Template of the ink materials of static props. See ss.SetupStaticProps.
    "$pixshader"    "splashsweps/staticprop_ps30"
    "$vertexshader" "splashsweps/staticprop_vs30"
    "$linearread_basetexture" "1"
    "$linearread_texture1"    "1"
    "$linearread_texture2"    "1"
    "$linearread_texture3"    "0"
    "$linearread_texture4"    "1"

    "$writealpha"   "1"
    "$cull"         "1"
    "$depthtest"    "1"
    "$vertexnormal" "1"
}
