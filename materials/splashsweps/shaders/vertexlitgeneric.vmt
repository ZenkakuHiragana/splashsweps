"VertexLitGeneric"
{
    // Flashlight light on the static props. See StaticPropRenderer.DrawFlashlight.
    // $alphatest: draws only where the depth equals. $nocull: the ink of $nocull materials has back faces.
    "$basetexture" "white"
    "$bumpmap"     "null-bumpmap"
    "$phong"       "0"
    "$alphatest"   "1"
    "$nocull"      "1"
}
